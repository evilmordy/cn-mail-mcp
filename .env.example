# Copy to .env (gitignored). Secrets only.
# Mode/allowlist live in .cn-mail-mcp.json (legacy .grok-bot-cn-mail.json / .qqconnect.json still work).
MAIL_USER=you@qq.com
MAIL_AUTH_CODE=

# Optional connection overrides
# MAIL_ACCOUNT_ID=qq
# MAIL_HOST=imap.qq.com
# MAIL_PORT=993
# MAIL_SMTP_HOST=smtp.qq.com
# MAIL_SMTP_PORT=465
# CN_MAIL_MCP_IMAP_ID=1
# (legacy) QQCONNECT_IMAP_ID=1

# Second mailbox (Grok Bot secret box: MAIL_USER_2 / MAIL_AUTH_CODE_2)
# MAIL_USER_2=work@163.com
# MAIL_AUTH_CODE_2=
# MAIL_ACCOUNT_ID_2=work

# Advanced: JSON addresses + auth codes in separate env vars
# CN_MAIL_MCP_ACCOUNTS=[{"id":"qq","address":"you@qq.com","authCodeEnv":"MAIL_AUTH_CODE"}]
# (legacy) QQCONNECT_ACCOUNTS=...

# Optional: loopback-only HTTP CONNECT proxy for IMAP/SMTP (Grok Bot box fake-IP egress).
# Tool schemas cannot set this. Host must be 127.0.0.1 / localhost / ::1; no socks; no credentials.
# On the Grok Bot box, SAND_EGRESS_TUNNEL_PROXY_ADDR is auto-used when this is unset.
# Preferred: CN_MAIL_MCP_MAIL_PROXY=http://127.0.0.1:8791
# Also accepted: CNMAIL_MAIL_PROXY, QQCONNECT_MAIL_PROXY (legacy)
