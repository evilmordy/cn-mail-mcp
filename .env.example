# 复制为 .env（已在 .gitignore 中）。只放连接信息，不要提交。
# 档位在 .cn-mail-mcp.json，不在这里。
# 也可以不写这个文件，改用 add_mailbox 写入本机账号文件。
MAIL_USER=you@qq.com
MAIL_AUTH_CODE=

# 可选的连接覆盖
# MAIL_ACCOUNT_ID=qq
# MAIL_HOST=imap.qq.com
# MAIL_PORT=993
# MAIL_SMTP_HOST=smtp.qq.com
# MAIL_SMTP_PORT=465
# MAIL_IMAP_ID=1

# 第二个邮箱
# MAIL_USER_2=work@163.com
# MAIL_AUTH_CODE_2=
# MAIL_ACCOUNT_ID_2=work

# JSON 多账号：只写地址，授权码放在另一个环境变量里
# CN_MAIL_MCP_ACCOUNTS=[{"id":"qq","address":"you@qq.com","authCodeEnv":"MAIL_AUTH_CODE"}]

# 可选：只允许本机回环的 HTTP CONNECT 代理，供 IMAP/SMTP 出站。
# 不能通过工具参数设置。主机必须是 127.0.0.1 / localhost / ::1；不要用 socks；不要带账号密码。
# CN_MAIL_MCP_MAIL_PROXY=http://127.0.0.1:8791
